# Bullion_Socials — environment configuration
# Copy to .env (gitignored) and fill in real values.

# HTTP/WS port
PORT=3000

# Public IP advertised to WebRTC clients / TURN
PUBLIC_IP=

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Static key for server-to-server control endpoints (/start-session,
# /save-session, /end-session). Must match SOCIALS_SERVICE_KEY in the Laravel
# backend. Generate with: openssl rand -hex 32
SOCIALS_SERVICE_KEY=

# HMAC secret used to verify per-session tokens that the app presents on the
# WebSocket handshake. Must match SOCIALS_TOKEN_SECRET in the Laravel backend.
# Generate with: openssl rand -hex 32
SOCIALS_TOKEN_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins permitted to call the HTTP API.
# Non-browser clients (mobile app, backend) are unaffected. Leave blank to deny
# all cross-origin browser requests.
SOCIALS_CORS_ORIGINS=

# ── TURN credentials ─────────────────────────────────────────────────────────
# No longer hardcoded. Rotate periodically. (Consider ephemeral TURN REST creds.)
TURN_USERNAME=stream
TURN_CREDENTIAL=

# ── Residential proxy (gateway + region-in-username style) ───────────────────
# Routes each browser session through a residential exit so logins (Instagram,
# etc.) aren't blocked for the datacenter IP. Leave SOCIALS_PROXY_SERVER blank to
# go direct. {region} = lowercased country code from the backend; {sid} = sticky
# session id (same exit IP for the whole session).
#   e.g. SOCIALS_PROXY_USERNAME="brd-customer-xxx-zone-resi-country-{region}-session-{sid}"
SOCIALS_PROXY_SERVER=
SOCIALS_PROXY_USERNAME=
SOCIALS_PROXY_PASSWORD=
SOCIALS_PROXY_DEFAULT_REGION=us
